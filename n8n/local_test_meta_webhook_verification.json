      "parameters": {
        "functionCode": "const query = items[0].json.query || {};\nconst mode = query['hub.mode'] || query['hub_mode'] || query['mode'];\nconst token = query['hub.verify_token'] || query['hub_verify_token'] || query['verify_token'];\nconst challenge = query['hub.challenge'] || query['hub_challenge'] || query['challenge'];\n\nconst expectedToken = $env.META_WEBHOOK_VERIFY_TOKEN;\n\nif (mode === 'subscribe' && token && expectedToken && token === expectedToken && challenge) {\n  return [{\n    json: {\n      isValid: true,\n      statusCode: 200,\n      challenge: String(challenge)\n    }\n  }];\n} else {\n  return [{\n    json: {\n      isValid: false,\n      statusCode: 403,\n      body: 'Forbidden: Invalid verification token or mode'\n    }\n  }];\n}"
      },
